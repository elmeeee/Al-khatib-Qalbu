// Copy to Secrets.xcconfig and fill in. Never commit Secrets.xcconfig.

API_KEY_GROQ = YOUR_GROQ_API_KEY_HERE
AI_MODEL = qwen/qwen3-32b

QF_OAUTH_CLIENT_SECRET_DEBUG = YOUR_PRELIVE_CLIENT_SECRET
QF_OAUTH_CLIENT_SECRET_RELEASE = YOUR_PRODUCTION_CLIENT_SECRET

// QF client must approve the same parent scopes as Debug/Release.xcconfig (QF_OAUTH_SCOPES).
// Sign out and sign in again after changing scopes so refresh_token is re-issued.
